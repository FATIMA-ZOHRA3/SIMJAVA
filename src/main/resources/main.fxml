<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controller.MainController"
      spacing="10"
      style="-fx-background-color: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);">

    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <!-- En-tête -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="🚦 TRAFFIC MONITOR - MAROC"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="Système en démarrage..."
               style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;"/>
    </HBox>

    <!-- Carte -->
    <StackPane fx:id="mapContainer" VBox.vgrow="ALWAYS"
               style="-fx-border-color: #34495e; -fx-border-width: 2; -fx-border-radius: 5;"/>

    <!-- Barre de contrôle -->
    <HBox spacing="8" alignment="CENTER">
        <!-- ✅ LES MÊMES NOMS QUE DANS MainController -->
        <Button text="📍 Ma Position" onAction="#centerOnUser"
                styleClass="quick-location-btn"/>

        <Button text="🚗 Route Casa-Rabat" onAction="#showCasablancaRabatRoute"
                styleClass="vehicle-btn"/>

        <Button text="🚦 Afficher Événements" onAction="#showAllTrafficEvents"
                styleClass="traffic-btn"/>

        <Button text="🗑️ Effacer Routes" onAction="#clearRoutes"
                styleClass="analyze-btn"/>

        <Button text="🗑️ Effacer Événements" onAction="#clearEvents"
                styleClass="analyze-btn"/>

        <Separator orientation="VERTICAL" prefHeight="30"/>

        <Button text="➕ Test Événement" onAction="#addTestEvent"
                styleClass="precise-location-btn"/>
    </HBox>

</VBox>